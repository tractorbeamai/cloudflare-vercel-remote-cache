{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "b534f6f9c114635cacb3cfd15861c516",
  "name": "tractorbeam-turbo-cache-nonprod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "cache": { "enabled": false },
  "vars": {
    "ACCESS_ISSUER": "",
    "PROJECT_ACCESS": {},
    "MAX_ARTIFACT_BYTES": 67108864,
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "tractorbeam-turbo-cache-nonprod",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
