{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tractorbeam-turbo-cache",
  "account_id": "b534f6f9c114635cacb3cfd15861c516",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Nonprod Terraform attaches exact SaaS hostnames after Access is active.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "cache": { "enabled": false },
  "vars": {
    "ACCESS_ISSUER": "https://tractorbeam-nonprod.cloudflareaccess.com",
    // Copy remote_cache_access_aud from the applied nonprod infra stack.
    "ACCESS_AUD": "",
    "MAX_ARTIFACT_BYTES": 67108864,
    // Add public service-token client IDs only alongside an Access Service Auth policy.
    "SERVICE_PROJECTS": {},
    // Copy remote_cache_project_groups from the applied nonprod infra stack.
    "PROJECTS": {
      "avathon": "Project: Avathon",
      "caddi": "Project: CADDi",
      "carlyle": "Project: Carlyle",
      "constellation": "Project: Constellation",
      "linden-investment": "Project: Linden (Investment)",
      "linden-tech": "Project: Linden (Tech)",
      "soc-2": "Project: SOC 2",
      "tempus": "Project: Tempus",
    },
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "tractorbeam-turbo-cache",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
