{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tractorbeam-turbo-cache-nonprod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "cache": { "enabled": false },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "ArtifactReader": { "type": "worker", "cache": { "enabled": true } },
  },
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_READ_AUD": "",
    "ACCESS_WRITE_AUD": "",
    "TEAM_ID": "team_tractorbeam",
    "TEAM_SLUG": "tractorbeam",
    "MAX_ARTIFACT_BYTES": 67108864,
    "CACHE_TTL_SECONDS": 300,
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "tractorbeam-turbo-cache-nonprod",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
