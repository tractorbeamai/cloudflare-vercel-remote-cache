{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tractorbeam-turbo-cache",
  "account_id": "b534f6f9c114635cacb3cfd15861c516",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Nonprod Terraform attaches exact SaaS hostnames after Access is active.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "cache": { "enabled": false },
  "vars": {
    "ACCESS_ISSUER": "https://tractorbeam-nonprod.cloudflareaccess.com",
    // Worker-level Access application audience from nonprod infra.
    "ACCESS_AUD": "7ea8f6af1327a517f315182447cc3982dd8f7d22b8af0973bdedfdd69458a526",
    "MAX_ARTIFACT_BYTES": 67108864,
    // Add public service-token client IDs only alongside an Access Service Auth policy.
    "SERVICE_PROJECTS": {},
    // Copy remote_cache_project_groups from the applied nonprod infra stack.
    "PROJECTS": {
      "constellation": "Project: Constellation",
    },
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "tractorbeam-turbo-cache",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
